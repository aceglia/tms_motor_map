{
    "mep_analysis": {
        "std_factor_mep": 3.5,
        "std_factor_baseline": 2.0,
        "simulation_time": 1.0,
        "baseline_window": [
            50,
            5
        ],
        "mep_window": [
            18,
            40
        ]
    },
    "grid_fitting": {
        "tile": false,
        "extend": "never",
        "interp": "nearest",
        "regularizer": "gradient",
        "solver": "normal",
        "autoscale": "on",
        "smoothness": 5.0,
        "n_points": 50
    },
    "plane_projection": {
        "ransac": true,
        "ransac_threshold": 1.0,
        "ransac_iterations": 1000,
        "target_to_align": [
            "(0, 0)",
            "(6, 0)"
        ],
        "exclude_outliers": true
    }
}